# Copy this file to .env for local development and fill in real values.
# .env is gitignored and must never be committed.
#
# In production these values are NOT read from this file — GitHub Actions
# writes the real .env on the runner from repository secrets, right before
# the FTP deploy step (see .github/workflows/deploy.yml), so the live
# credentials never touch git. Add these as repository secrets in GitHub:
# Settings -> Secrets and variables -> Actions -> New repository secret.

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=ailearner

ASSEMBLYAI_API_KEY=
